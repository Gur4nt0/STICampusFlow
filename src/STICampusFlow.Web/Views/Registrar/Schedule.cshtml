@model ScheduleSettingsViewModel
@{
    ViewData["Title"] = "Capacity & closures";
}

<div class="page-head">
    <div>
        <h1>Capacity &amp; closures</h1>
        <p>
            Close a date so no one can book it, or change how many students a window can hold.
            Students see these changes on the booking calendar immediately.
        </p>
    </div>
</div>

<!-- ===== Current office rules ===== -->
<div class="rule-grid">
    <div class="rule-card">
        <small>Operating hours</small>
        <b>@DateTime.Today.Add(Model.Options.Open).ToString("h:mm tt") – @DateTime.Today.Add(Model.Options.Close).ToString("h:mm tt")</b>
        <span>Monday to Friday</span>
    </div>
    <div class="rule-card">
        <small>Lunch break</small>
        <b>@DateTime.Today.Add(Model.Options.LunchStart).ToString("h:mm tt") – @DateTime.Today.Add(Model.Options.LunchEnd).ToString("h:mm tt")</b>
        <span>Not bookable</span>
    </div>
    <div class="rule-card">
        <small>Default capacity</small>
        <b>@Model.Options.DefaultSlotCapacity per window</b>
        <span>@Model.SlotStarts.Count windows a day</span>
    </div>
    <div class="rule-card">
        <small>Booking horizon</small>
        <b>@Model.Options.MaxAdvanceBookingDays days ahead</b>
        <span>Min. @Model.Options.MinLeadTimeHours h lead time</span>
    </div>
</div>

<p class="panel-sub" style="margin-top:12px">
    These defaults come from <code>appsettings.json</code> under the <code>Registrar</code> section —
    change them there to adjust the whole office at once.
</p>

<div class="detail-grid">
    <!-- ===== Closures ===== -->
    <section class="panel">
        <h3>Closed dates</h3>
        <p class="panel-sub">Holidays, campus events, inventory days.</p>

        <form method="post" asp-action="BlockDate" class="stack-form">
            @Html.AntiForgeryToken()
            <div class="field-row">
                <div class="id-field">
                    <label for="newBlockedDate">Date</label>
                    <input type="date" id="newBlockedDate" name="newBlockedDate" required
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="id-field">
                    <label for="newBlockedReason">Reason</label>
                    <input type="text" id="newBlockedReason" name="newBlockedReason" required
                           maxlength="160" placeholder="e.g. All Saints' Day" />
                </div>
            </div>
            <button type="submit" class="btn btn-teal">Close this date</button>
        </form>

        <div class="summary-divider"></div>

        @if (Model.BlockedDates.Count == 0)
        {
            <p class="empty-note">No closures are recorded.</p>
        }
        else
        {
            <ul class="mini-list">
                @foreach (var blocked in Model.BlockedDates)
                {
                    var confirmText = $"Reopen {blocked.Date:MMMM d} for appointments?";
                    <li>
                        <div>
                            <b>@blocked.Date.ToString("ddd, MMM d, yyyy")</b>
                            <span>@blocked.Reason</span>
                        </div>
                        <form method="post" asp-action="UnblockDate" asp-route-id="@blocked.Id"
                              onsubmit="return confirm('@confirmText');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-link btn-link-danger">Reopen</button>
                        </form>
                    </li>
                }
            </ul>
        }
    </section>

    <!-- ===== Capacity ===== -->
    <section class="panel">
        <h3>Capacity overrides</h3>
        <p class="panel-sub">Use this when you are short-staffed, or when enrolment week needs extra room.</p>

        <form method="post" asp-action="SetCapacity" class="stack-form">
            @Html.AntiForgeryToken()
            <div class="field-row">
                <div class="id-field">
                    <label for="newCapacityDate">Date</label>
                    <input type="date" id="newCapacityDate" name="newCapacityDate" required
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="id-field">
                    <label for="newCapacitySlot">Window</label>
                    <select id="newCapacitySlot" name="newCapacitySlot">
                        <option value="">Every window that day</option>
                        @foreach (var slot in Model.SlotStarts)
                        {
                            <option value="@slot.ToString("hh\\:mm")">@DateTime.Today.Add(slot).ToString("h:mm tt")</option>
                        }
                    </select>
                </div>
                <div class="id-field id-field-narrow">
                    <label for="newCapacityValue">Capacity</label>
                    <input type="number" id="newCapacityValue" name="newCapacityValue"
                           value="@Model.NewCapacityValue" min="0" max="200" required />
                </div>
            </div>
            <button type="submit" class="btn btn-teal">Save override</button>
        </form>

        <div class="summary-divider"></div>

        @if (Model.CapacityOverrides.Count == 0)
        {
            <p class="empty-note">No overrides — every window uses the default of @Model.Options.DefaultSlotCapacity.</p>
        }
        else
        {
            <ul class="mini-list">
                @foreach (var item in Model.CapacityOverrides)
                {
                    <li>
                        <div>
                            <b>@item.Date.ToString("ddd, MMM d, yyyy")</b>
                            <span>
                                @(item.SlotStart.HasValue
                                    ? DateTime.Today.Add(item.SlotStart.Value).ToString("h:mm tt")
                                    : "All windows")
                                · capacity @item.Capacity
                            </span>
                        </div>
                        <form method="post" asp-action="RemoveCapacity" asp-route-id="@item.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-link btn-link-danger">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }
    </section>
</div>

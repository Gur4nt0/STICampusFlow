{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "//comment": "Provider can be 'Sqlite' (zero setup, runs offline) or 'SqlServer'.",
    "Provider": "Sqlite",
    "SeedDemoData": true
  },

  "ConnectionStrings": {
    "Sqlite": "Data Source=campusflow.db",
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=STICampusFlow;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  "Registrar": {
    "OfficeName": "Office of the Registrar",
    "CampusName": "STI College Global City",
    "OpenTime": "08:00",
    "CloseTime": "17:00",
    "SlotMinutes": 60,
    "LunchBreakStart": "12:00",
    "LunchBreakEnd": "13:00",
    "DefaultSlotCapacity": 8,
    "MaxAdvanceBookingDays": 45,
    "MinLeadTimeHours": 2,
    "MaxOpenRequestsPerStudent": 3,
    "AutoVoidMissedAppointments": true
  }
}
